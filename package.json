{
  "name": "@ddocbot/element",
  "version": "0.1.0",
  "description": "A tiny pixel robot companion for the web",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dotDocType/ddocBot.git"
  },
  "bugs": {
    "url": "https://github.com/dotDocType/ddocBot/issues"
  },
  "homepage": "https://github.com/dotDocType/ddocBot#readme",
  "type": "module",
  "exports": {".": {"types": "./src/index.d.ts", "import": "./src/index.js"}},
  "types": "./src/index.d.ts",
  "files": ["src", "README.md", "TRADEMARKS.md"],
  "sideEffects": false,
  "workspaces": ["examples/*"],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "test": "node --test tests/*.test.js",
    "test:types": "npm exec --workspace=@ddocbot/example-angular -- tsc -p ../../tests/types/tsconfig.json",
    "test:browser": "playwright test",
    "build:examples": "npm run build --workspaces --if-present"
  },
  "devDependencies": {"@playwright/test": "^1.58.0", "vite": "^7.3.0"}
}
